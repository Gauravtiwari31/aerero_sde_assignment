# ==========================================================================
# Geospatial File Measurement API - Configuration
# ==========================================================================
# Copy to .env and adjust. Every value below is optional; the defaults in
# app/config.py are used when a variable is absent.
# ==========================================================================

# --- Application ---
APP_NAME="Geospatial File Measurement API"
APP_VERSION="2.0.0"
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite by default. For production, point at PostgreSQL + PostGIS, e.g.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/geospatial
DATABASE_URL=sqlite+aiosqlite:///./data/geospatial.db

# --- File Storage ---
UPLOAD_DIR=./data/uploads

# --- Upload Constraints ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.zip,.kml

# --- CRS / Projection ---
# Fallback only. The primary strategy selects the UTM zone covering each
# dataset's centroid; this is used only when that estimation fails.
DEFAULT_PROJECTED_CRS=EPSG:3857

# --- CORS ---
# Comma-separated origins, or "*" for any. Tighten this in production.
CORS_ORIGINS=*
